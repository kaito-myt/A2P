# KDP 自宅プロキシ オーケストレータ設定 (scripts/kdp-home-proxy.mjs)
# このファイルを scripts/.kdp-proxy.env にコピーして値を埋めてください。
# .kdp-proxy.env は gitignore 済み(コミットされません)。

# Railway の公開 Postgres URL (Variables タブの DATABASE_PUBLIC_URL)
DATABASE_PUBLIC_URL=postgresql://postgres:xxxx@maglev.proxy.rlwy.net:16049/railway

# プロキシ認証情報。Railway の A2P-Worker サービスの env と「完全一致」させること。
# 強いランダム値を使う (例: openssl rand -hex 16)。
KDP_PROXY_USER=
KDP_PROXY_PASS=

# ローカルで待ち受けるポート (既定 8899)。他プロセスと衝突する場合のみ変更。
# KDP_PROXY_LOCAL_PORT=8899

# ngrok 実行ファイルのパス (PATH に無い場合のみ)。
# NGROK_PATH=ngrok
